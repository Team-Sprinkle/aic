<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_rl</name>
  <version>0.0.1</version>
  <description>Low-throughput Gazebo RL bridge for the AIC ROS/Gazebo stack</description>
  <maintainer email="dev@team-sprinkle.invalid">Team Sprinkle</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>aic_control_interfaces</exec_depend>
  <exec_depend>aic_model</exec_depend>
  <exec_depend>aic_model_interfaces</exec_depend>
  <exec_depend>aic_task_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
