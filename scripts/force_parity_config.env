# Shared config for Gazebo/Isaac force parity scripts.
# Both scripts source this file first, then allow env-var overrides.

# Common output location inside AIC repo
OUT_DIR=outputs/force_parity

# Shared trial config (used by Gazebo eval bringup)
ENGINE_CONFIG_FILE=outputs/configs/fixed_5_trials_sfp2nic.yaml

# Shared parity scenario parameters
MISALIGN_X_M=0.004
MISALIGN_Y_M=0.004
DESCEND_SPEED_MPS=0.0009

# Gazebo-side defaults
SIM_DISTROBOX_NAME=aic_eval
GROUND_TRUTH=true
DURATION_S=20.0
SHUTDOWN_ON_ENGINE_EXIT=true
GAZEBO_GUI=true
LAUNCH_RVIZ=true

# Isaac-side defaults
TASK=AIC-Task-v0
SETTLE_SECONDS=2.0
ALIGN_SECONDS=1.0
DESCEND_SECONDS=6.0
HOLD_SECONDS=2.0
TOTAL_SECONDS=12.0
DEVICE=cuda:0
HEADLESS=false
